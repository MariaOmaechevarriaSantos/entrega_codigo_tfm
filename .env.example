# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno del proyecto. Copia a .env y ajusta lo que necesites.
# Todas tienen valor por defecto sensato: .env es OPCIONAL para levantar
# `docker compose up`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Restricciones físicas del camión de referencia (motor de rutas, P4) ---
# OBLIGATORIAS solo si quieres cambiar el vehículo por defecto. Afectan a TODO
# el cálculo de rutas: no las toques sin querer.
ANCHO_CAMION_REQ=3.5
GALIBO_REQ=4.0

# --- Empaquetado / arranque (docker compose, bloque 8) ---

# OPCIONAL. URL de descarga de artifacts.tar.gz (GitHub Release). Si se deja
# vacía, data-init SOLO puede poblar el volumen desde ./dist/artifacts.tar.gz
# (ruta offline). Con el tarball local presente, esta variable es innecesaria.
ARTIFACTS_URL=

# OPCIONAL. Puertos publicados en el host.
API_PORT=8080
DASHBOARD_PORT=8501

# OPCIONAL. Límites de memoria de los contenedores (sintaxis de docker).
API_MEM_LIMIT=2g
DASHBOARD_MEM_LIMIT=1g

# --- Runtime de la API ---

# OPCIONAL. Ruta de la DuckDB. En compose ya se fija al fichero del volumen.
# Ponla a `md:tfm_madrid` (+ MOTHERDUCK_TOKEN) para usar MotherDuck en vez de
# un fichero local.
# DUCKDB_PATH=/app/data/processed/tfm_madrid.duckdb
# MOTHERDUCK_TOKEN=

# OPCIONAL. Nº de workers de gunicorn. Déjalo en 1: el grafo (~1 GB RSS) se
# carga una vez con --preload y se comparte por fork; subirlo multiplica la RAM.
WORKERS=1

# OPCIONAL. Nivel de los logs estructurados JSON de la API (bloque 8B):
# DEBUG | INFO | WARNING | ERROR. Por defecto INFO.
LOG_LEVEL=INFO

# --- Identidad de la build para GET /version (bloque 8B) ---
# NO se ponen a mano: `make up` las calcula (git rev-parse --short=12, fecha
# UTC, sha256 de artifacts.manifest.json) y las pasa como build args. Con
# `docker compose up` a secas quedan como "desconocido".
# GIT_SHA=
# BUILD_DATE=
# MANIFEST_SHA256=

# OPCIONAL. Prefect (solo si ejecutas el pipeline, no para servir).
# PREFECT_API_URL=http://127.0.0.1:4200/api

# OPCIONAL. AEMET como fuente meteorológica alternativa (nunca obligatoria;
# el dashboard usa por defecto el feed municipal en vivo).
# AEMET_API_KEY=
